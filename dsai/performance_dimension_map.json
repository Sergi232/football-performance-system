{
  "version": "performance_dimension_map_0.1.0",
  "status": "structural_mapping_only_no_direction_no_weight_no_score",
  "principles": [
    "Every approved FEATURE-01 metric has exactly one primary performance dimension.",
    "Primary dimension mapping prevents silent double counting in a future global score.",
    "A feature may remain contextual evidence in the expert tree without being counted twice in the performance score.",
    "Mapping does not assign positive/negative direction, weight, threshold or score eligibility.",
    "Goalkeeping is role-specific; role/position remains context rather than the main prediction target."
  ],
